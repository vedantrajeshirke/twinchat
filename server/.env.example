# ---- Core ----
# 5050 rather than 5000: macOS Control Center (AirPlay Receiver) occupies 5000.
PORT=5050
NODE_ENV=development

# ---- Database ----
# MongoDB Atlas connection string. Leave BLANK in development and the server
# will boot an in-process MongoDB (mongodb-memory-server) automatically.
MONGO_URI=

# ---- Auth ----
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d

# ---- CORS ----
CLIENT_URL=http://localhost:5173

# ---- Cloudinary (optional in dev) ----
# Leave BLANK and uploads are written to server/uploads/ and served locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
